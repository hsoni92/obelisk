# Binaries (Makefile: bin/obelisk, bin/obelisk-controller)
/bin/
/obelisk
/obelisk-controller
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test and coverage
*.test
*.out
coverage.out
coverage.html
*.coverprofile
profile.cov

# Modules / workspace (vendoring is opt-in)
/vendor/
go.work
go.work.sum

# Delve and other debug binaries
__debug_bin
__debug_bin*

# Local cluster + controller dev state (see docs/runbooks/install.md)
/dev/kubeconfig
/dev/obelisk.yaml
/dev/state-history.jsonl
/dev/credentials/
/dev/*.credentials.json

# Environment and secrets
.env
.env.*
!.env.example

# OS and editors
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Node / front-end (web/admin also has web/admin/.gitignore)
node_modules/
.npm
.pnpm-store
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Front-end build output
.next/
out/
dist/
.nuxt
.output
.vercel
.vite/
**/.vitepress/dist
**/.vitepress/cache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Test / tooling coverage (JS)
coverage/
*.lcov
.nyc_output

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches
.cache/
.parcel-cache
.turbo

# EGM scratch artifacts (before approval)
.dev/docs
concepts_brief.md
design_draft.md