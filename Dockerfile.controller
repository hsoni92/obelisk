FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod ./
COPY . .
# go mod tidy needs the module proxy; retry so a transient network reset does not fail the image build.
RUN for i in 1 2 3 4 5; do go mod tidy && break; [ "$i" -eq 5 ] && exit 1; echo "go mod tidy failed (attempt $i), retrying"; sleep $((i * 10)); done \
	&& CGO_ENABLED=0 go build -o /out/obelisk-controller ./cmd/obelisk-controller

FROM debian:bookworm-slim
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl gnupg git \
	&& curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash \
	&& curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/v1.30.7/bin/linux/amd64/kubectl" \
	&& chmod +x /usr/local/bin/kubectl \
	&& curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg | tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null \
	&& curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list | tee /etc/apt/sources.list.d/tailscale.list \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends tailscale util-linux \
	&& apt-get purge -y curl gnupg \
	&& apt-get autoremove -y \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=build /out/obelisk-controller /usr/local/bin/obelisk-controller
ENTRYPOINT ["/usr/local/bin/obelisk-controller"]